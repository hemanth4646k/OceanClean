# Every setting and its only default. Compose always loads this file, then an optional .env
# (never committed) whose values override it. Code reads settings without fallbacks.
POSTGRES_USER=ocean
POSTGRES_PASSWORD=ocean
POSTGRES_DB=oceanclean
POSTGRES_HOST=postgis
POSTGRES_PORT=5432
MINIO_ROOT_USER=oceanadmin
MINIO_ROOT_PASSWORD=oceanadmin123
MINIO_ENDPOINT=minio:9000
LAKE_BUCKET=oceanclean
KAFKA_BOOTSTRAP=kafka:9092
# Telemetry topic partitions; also Spark's shuffle partitions.
TELEMETRY_PARTITIONS=6
INGEST_URL=http://ingestion:8000/telemetry
SURVEY_URL=http://ingestion:8000/debris-survey
VESSEL_ID=OC-01
SIM_RATE=60
SIM_START=2026-09-01T00:00:00Z
SIM_TICK_SECONDS=60
SIM_STATE_DIR=/state
CHECKPOINT_DIR=/checkpoints/telemetry
SURVEY_CHECKPOINT_DIR=/checkpoints/debris_survey
STREAM_TRIGGER=2 seconds
# Fetch-and-cache directory for NOAA downloads (host data/cache, survives `down -v`).
CACHE_DIR=/app/data/cache

# M5: the watermarked window query's checkpoint; HITL autopilot default and decision timeout (real s)
WINDOW_CHECKPOINT_DIR=/checkpoints/windows
AUTOPILOT=true
HITL_TIMEOUT_S=30
# Seconds between telemetry-etl runs of the `analytics` service (Analytics tab freshness)
ANALYTICS_REFRESH_S=180
